**free
// =====================================================================================
// XLSX02R - ZIP reader with inflate (RFC 1951: stored, fixed and dynamic blocks)
//
// Part of the XLSX writer (XLSX00R), used by MODE(*ADDSHEET) and MODE(*APPEND).
// The archive is loaded in memory (teraspace), the central directory is parsed, and an
// entry is either inflated (zrGet) or handed over raw for a byte copy (zrEntry + zwRaw).
// Decoding: 9-bit lookup table, canonical bit-by-bit decode for longer codes (puff).
// CRC-32 of every inflated entry is checked. No ZIP64, no encryption.
//
// Build: CRTRPGMOD MODULE(QTEMP/XLSX02R) SRCSTMF('<dir>/XLSX02R.rpgle') INCDIR('<dir>')
//          DBGVIEW(*SOURCE) OPTIMIZE(*FULL) TGTCCSID(*JOB)       (see XLSXDIST.clle)
// Version 1.4.1 (2026-11-17): product version XLSX_VERSION in XLSXINT.rpgleinc
// =====================================================================================
ctl-opt nomain alloc(*teraspace) bnddir('QC2LE')
        option(*srcstmt : *nodebugio : *nounref);

/copy 'XLSXINT.rpgleinc'

dcl-pr ifsOpen int(10) extproc('open');
  path  pointer value options(*string);
  oflag int(10) value;
end-pr;
dcl-pr ifsRead int(10) extproc('read');
  fd  int(10) value;
  buf pointer value;
  n   uns(10) value;
end-pr;
dcl-pr ifsClose int(10) extproc('close');
  fd int(10) value;
end-pr;
dcl-pr ifsSeek int(20) extproc('lseek64');
  fd     int(10) value;
  offset int(20) value;
  whence int(10) value;
end-pr;
dcl-c O_RDONLY     1;
dcl-c O_LARGEFILE  536870912;

dcl-ds huf_t qualified template;
  cnt  int(10) dim(16);              // codes per length (cnt(L+1))
  sym  int(10) dim(320);             // symbols ordered by code
  fast int(10) dim(512);             // 9-bit lookup: sym*16 + len, 0 = use slow path
end-ds;

// ---- archive -------------------------------------------------------------------------
dcl-s pZ   pointer inz(*null);       // whole file
dcl-s zLen int(20);
dcl-ds ent likeds(zrEnt_t) dim(4000);
dcl-s nEnt int(10);

// ---- inflate state -------------------------------------------------------------------
dcl-s pIn  pointer;
dcl-s inLen int(20);
dcl-s ip   int(20);                  // next input byte (0-based)
dcl-s bb   uns(20);                  // bit buffer
dcl-s bc   int(10);                  // bits in bb
dcl-s pOut pointer;
dcl-s oLen int(20);
dcl-s oCap int(20);
dcl-s bad  ind;

dcl-s tabsDone ind inz(*off);
dcl-s P2    uns(20) dim(64);
dcl-s LBASE int(10) dim(29);
dcl-s LEXT  int(10) dim(29);
dcl-s DBASE int(10) dim(30);
dcl-s DEXT  int(10) dim(30);
dcl-s CLORD int(10) dim(19);
dcl-ds fixL likeds(huf_t);
dcl-ds fixD likeds(huf_t);


// ---- local prototypes (procedures used before their definition) ----------------------
dcl-pr inflate ind;
end-pr;
dcl-pr hufBuild;
  lens  int(10) dim(320) const;
  first int(10) value;
  nsym  int(10) value;
  t     likeds(huf_t);
end-pr;

// =====================================================================================
// little endian readers on the archive image (0-based offsets)
// =====================================================================================
dcl-proc rd16;
  dcl-pi *n int(10);
    off int(20) value;
  end-pi;
  dcl-s p pointer;
  dcl-s b uns(3) based(p);
  dcl-s v int(10);
  p = pZ + off;
  v = b;
  p += 1;
  return v + b * 256;
end-proc;

dcl-proc rd32;
  dcl-pi *n uns(10);
    off int(20) value;
  end-pi;
  return rd16(off) + rd16(off + 2) * 65536;
end-proc;

// =====================================================================================
// archive
// =====================================================================================
dcl-proc zrClose export;
  if pZ <> *null;
    dealloc(n) pZ;
  endif;
  zLen = 0;
  nEnt = 0;
end-proc;

dcl-proc zrOpen export;
  dcl-pi *n int(10);
    path varchar(1024) const;
  end-pi;
  dcl-s fd int(10);
  dcl-s got int(20);
  dcl-s k int(10);
  dcl-s want int(10);
  dcl-s p int(20);
  dcl-s stop int(20);
  dcl-s n int(10);
  dcl-s cdOff int(20);
  dcl-s q int(20);
  dcl-s i int(10);
  dcl-s nl int(10);
  dcl-s el int(10);
  dcl-s cl int(10);
  dcl-s loff int(20);

  zrClose();
  fd = ifsOpen(%trimr(path) : O_RDONLY + O_LARGEFILE);
  if fd < 0;
    xlSetErr('cannot open ' + %trimr(path));
    return -1;
  endif;
  zLen = ifsSeek(fd : 0 : 2);
  if zLen < 22 or ifsSeek(fd : 0 : 0) <> 0;
    ifsClose(fd);
    xlSetErr(%trimr(path) + ' is not a zip/xlsx file');
    return -1;
  endif;
  if zLen > 2000000000;
    ifsClose(fd);
    xlSetErr(%trimr(path) + ' is too large to update');
    return -1;
  endif;
  pZ = %alloc(zLen + 16);
  got = 0;
  dow got < zLen;
    want = 16000000;
    if zLen - got < want;
      want = zLen - got;
    endif;
    k = ifsRead(fd : pZ + got : want);
    if k <= 0;
      leave;
    endif;
    got += k;
  enddo;
  ifsClose(fd);
  if got <> zLen;
    zrClose();
    xlSetErr('read error on ' + %trimr(path));
    return -1;
  endif;

  // end of central directory: PK\5\6, searched backwards (max comment 64 KB)
  p = zLen - 22;
  stop = zLen - 65557;
  if stop < 0;
    stop = 0;
  endif;
  dow p >= stop;
    if rd32(p) = 101010256;
      leave;
    endif;
    p -= 1;
  enddo;
  if p < stop;
    zrClose();
    xlSetErr(%trimr(path) + ': zip directory not found');
    return -1;
  endif;
  n = rd16(p + 10);
  cdOff = rd32(p + 16);
  if n > XL_MAXENT or cdOff = 4294967295 or n = 65535;
    zrClose();
    xlSetErr(%trimr(path) + ': ZIP64 or too many entries, not supported');
    return -1;
  endif;
  q = cdOff;
  for i = 1 to n;
    bad = (q + 46 > zLen);
    if not bad;
      bad = (rd32(q) <> 33639248);
    endif;
    if bad;
      zrClose();
      xlSetErr(%trimr(path) + ': damaged zip directory');
      return -1;
    endif;
    ent(i).flags  = rd16(q + 8);
    ent(i).method = rd16(q + 10);
    ent(i).dtime  = rd16(q + 12);
    ent(i).ddate  = rd16(q + 14);
    ent(i).crc    = rd32(q + 16);
    ent(i).csize  = rd32(q + 20);
    ent(i).usize  = rd32(q + 24);
    nl = rd16(q + 28);
    el = rd16(q + 30);
    cl = rd16(q + 32);
    loff = rd32(q + 42);
    if nl > 512;
      nl = 512;
    endif;
    %len(ent(i).name) = nl;
    if nl > 0;
      memcpy(%addr(ent(i).name : *data) : pZ + q + 46 : nl);
    endif;
    bad = (loff + 30 > zLen);
    if not bad;
      bad = (rd32(loff) <> 67324752);
    endif;
    if bad;
      zrClose();
      xlSetErr(%trimr(path) + ': damaged local header');
      return -1;
    endif;
    ent(i).data = pZ + loff + 30 + rd16(loff + 26) + rd16(loff + 28);
    if loff + 30 + rd16(loff + 26) + rd16(loff + 28) + ent(i).csize > zLen;
      zrClose();
      xlSetErr(%trimr(path) + ': truncated entry');
      return -1;
    endif;
    q += 46 + nl + el + cl;
  endfor;
  nEnt = n;
  return n;
end-proc;

dcl-proc zrFind export;
  dcl-pi *n int(10);
    name varchar(512) ccsid(*utf8) const;
  end-pi;
  dcl-s i int(10);
  for i = 1 to nEnt;
    if ent(i).name = name;
      return i;
    endif;
  endfor;
  return 0;
end-proc;

dcl-proc nameOf;                    // entry name in the job CCSID (messages)
  dcl-pi *n varchar(512);
    idx int(10) value;
  end-pi;
  dcl-s nm varchar(512);
  nm = ent(idx).name;
  return nm;
end-proc;

dcl-proc zrEntry export;
  dcl-pi *n int(10);
    idx int(10) value;
    e likeds(zrEnt_t);
  end-pi;
  if idx < 1 or idx > nEnt;
    return -1;
  endif;
  e = ent(idx);
  return 0;
end-proc;

dcl-proc zrGet export;
  dcl-pi *n pointer;
    idx int(10) value;
    len int(10);
  end-pi;
  len = 0;
  if idx < 1 or idx > nEnt;
    xlSetErr('zrGet: bad entry');
    return *null;
  endif;
  if %bitand(ent(idx).flags : 1) <> 0;
    xlSetErr('encrypted zip entry ' + nameOf(idx));
    return *null;
  endif;
  oCap = ent(idx).usize;
  if oCap > 2000000000;
    xlSetErr('zip entry too large');
    return *null;
  endif;
  pOut = %alloc(oCap + 16);
  oLen = 0;
  if ent(idx).method = 0;
    if ent(idx).csize <> ent(idx).usize;
      dealloc(n) pOut;
      xlSetErr('bad stored entry');
      return *null;
    endif;
    if oCap > 0;
      memcpy(pOut : ent(idx).data : oCap);
    endif;
    oLen = oCap;
  elseif ent(idx).method = 8;
    pIn = ent(idx).data;
    inLen = ent(idx).csize;
    if not inflate();
      dealloc(n) pOut;
      return *null;
    endif;
  else;
    dealloc(n) pOut;
    xlSetErr('unsupported zip method ' + %char(ent(idx).method));
    return *null;
  endif;
  if oLen <> oCap or xlCrc32(0 : pOut : oLen) <> ent(idx).crc;
    dealloc(n) pOut;
    xlSetErr('CRC/size error in zip entry ' + nameOf(idx));
    return *null;
  endif;
  len = oLen;
  return pOut;
end-proc;

// =====================================================================================
// inflate
// =====================================================================================
dcl-proc infInit;
  dcl-s k int(10);
  dcl-s lens int(10) dim(320);
  P2(1) = 1;
  for k = 2 to 63;
    P2(k) = P2(k - 1) * 2;
  endfor;
  for k = 1 to 29;
    if k <= 8 or k = 29;
      LEXT(k) = 0;
    else;
      LEXT(k) = %div(k - 9 : 4) + 1;
    endif;
  endfor;
  LBASE(1) = 3;
  for k = 2 to 28;
    LBASE(k) = LBASE(k - 1) + P2(LEXT(k - 1) + 1);
  endfor;
  LBASE(29) = 258;
  DBASE(1) = 1;
  for k = 1 to 30;
    if k <= 4;
      DEXT(k) = 0;
    else;
      DEXT(k) = %div(k - 3 : 2);
    endif;
    if k > 1;
      DBASE(k) = DBASE(k - 1) + P2(DEXT(k - 1) + 1);
    endif;
  endfor;
  CLORD(1) = 16;
  CLORD(2) = 17;
  CLORD(3) = 18;
  CLORD(4) = 0;
  CLORD(5) = 8;
  CLORD(6) = 7;
  CLORD(7) = 9;
  CLORD(8) = 6;
  CLORD(9) = 10;
  CLORD(10) = 5;
  CLORD(11) = 11;
  CLORD(12) = 4;
  CLORD(13) = 12;
  CLORD(14) = 3;
  CLORD(15) = 13;
  CLORD(16) = 2;
  CLORD(17) = 14;
  CLORD(18) = 1;
  CLORD(19) = 15;
  for k = 1 to 288;
    if k <= 144;
      lens(k) = 8;
    elseif k <= 256;
      lens(k) = 9;
    elseif k <= 280;
      lens(k) = 7;
    else;
      lens(k) = 8;
    endif;
  endfor;
  hufBuild(lens : 1 : 288 : fixL);
  for k = 1 to 30;
    lens(k) = 5;
  endfor;
  hufBuild(lens : 1 : 30 : fixD);
  tabsDone = *on;
end-proc;

// decoding tables from code lengths lens(first .. first+nsym-1)
dcl-proc hufBuild;
  dcl-pi *n;
    lens  int(10) dim(320) const;
    first int(10) value;
    nsym  int(10) value;
    t     likeds(huf_t);
  end-pi;
  dcl-s offs int(10) dim(16);
  dcl-s o int(10);
  dcl-s s int(10);
  dcl-s l int(10);
  dcl-s j int(10);
  dcl-s k int(10);
  dcl-s code int(10);
  dcl-s r int(10);
  dcl-s f int(10);
  dcl-s b int(10);
  dcl-s v int(10);

  t.cnt = 0;
  t.fast = 0;
  for s = 0 to nsym - 1;
    t.cnt(lens(first + s) + 1) += 1;
  endfor;
  t.cnt(1) = 0;
  o = 0;
  for l = 1 to 15;
    offs(l + 1) = o;
    o += t.cnt(l + 1);
  endfor;
  for s = 0 to nsym - 1;
    l = lens(first + s);
    if l > 0;
      t.sym(offs(l + 1) + 1) = s;
      offs(l + 1) += 1;
    endif;
  endfor;
  // fast table for codes up to 9 bits
  code = 0;
  k = 0;
  for l = 1 to 15;
    for j = 1 to t.cnt(l + 1);
      if l <= 9;
        r = 0;                        // bit reverse of code (l bits)
        v = code;
        for b = 1 to l;
          r = r * 2 + %rem(v : 2);
          v = %div(v : 2);
        endfor;
        f = r;
        dow f < 512;
          t.fast(f + 1) = t.sym(k + 1) * 16 + l;
          f += P2(l + 1);
        enddo;
      endif;
      code += 1;
      k += 1;
    endfor;
    code *= 2;
  endfor;
end-proc;

dcl-proc needBits;
  dcl-pi *n;
    n int(10) value;
  end-pi;
  dcl-s p pointer;
  dcl-s b uns(3) based(p);
  dow bc < n;
    if ip < inLen;
      p = pIn + ip;
      bb += b * P2(bc + 1);
    elseif ip > inLen + 8;
      bad = *on;
    endif;
    ip += 1;
    bc += 8;
  enddo;
end-proc;

dcl-proc getBits;
  dcl-pi *n int(10);
    n int(10) value;
  end-pi;
  dcl-s v int(10);
  if n = 0;
    return 0;
  endif;
  if bc < n;
    needBits(n);
  endif;
  v = %rem(bb : P2(n + 1));
  bb = %div(bb : P2(n + 1));
  bc -= n;
  return v;
end-proc;

dcl-proc decode;
  dcl-pi *n int(10);
    t likeds(huf_t);
  end-pi;
  dcl-s e int(10);
  dcl-s l int(10);
  dcl-s code int(10);
  dcl-s firstC int(10);
  dcl-s index int(10);
  dcl-s c int(10);
  if bc < 9;
    needBits(9);
  endif;
  e = t.fast(%rem(bb : 512) + 1);
  if e > 0;
    l = %rem(e : 16);
    bb = %div(bb : P2(l + 1));
    bc -= l;
    return %div(e : 16);
  endif;
  code = 0;
  firstC = 0;
  index = 0;
  for l = 1 to 15;
    code += getBits(1);
    c = t.cnt(l + 1);
    if code - c < firstC;
      return t.sym(index + code - firstC + 1);
    endif;
    index += c;
    firstC += c;
    firstC *= 2;
    code *= 2;
  endfor;
  bad = *on;
  return -1;
end-proc;

dcl-proc inflate;
  dcl-pi *n ind;
  end-pi;
  dcl-ds tl likeds(huf_t);
  dcl-ds td likeds(huf_t);
  dcl-ds tc likeds(huf_t);
  dcl-s lens int(10) dim(320);
  dcl-s cl int(10) dim(320);
  dcl-s lastB int(10);
  dcl-s typ int(10);
  dcl-s n int(10);
  dcl-s nlen int(10);
  dcl-s ndist int(10);
  dcl-s ncode int(10);
  dcl-s i int(10);
  dcl-s k int(10);
  dcl-s sy int(10);
  dcl-s v int(10);
  dcl-s r int(10);
  dcl-s c int(10);
  dcl-s l int(10);
  dcl-s d int(10);
  dcl-s dr int(10);
  dcl-s useFix ind;
  dcl-s ps pointer;
  dcl-s pd pointer;
  dcl-s bs uns(3) based(ps);
  dcl-s bd uns(3) based(pd);

  if not tabsDone;
    infInit();
  endif;
  ip = 0;
  bb = 0;
  bc = 0;
  bad = *off;
  oLen = 0;
  dou lastB = 1;
    lastB = getBits(1);
    typ = getBits(2);
    if typ = 0;
      // stored: drop to the byte boundary, give back prefetched whole bytes
      dr = %rem(bc : 8);
      bb = %div(bb : P2(dr + 1));
      bc -= dr;
      ip -= %div(bc : 8);
      bb = 0;
      bc = 0;
      if ip + 4 > inLen;
        xlSetErr('inflate: truncated stored block');
        return *off;
      endif;
      ps = pIn + ip;
      n = bs;
      ps += 1;
      n += bs * 256;
      ip += 4;
      if ip + n > inLen or oLen + n > oCap;
        xlSetErr('inflate: bad stored block');
        return *off;
      endif;
      if n > 0;
        memcpy(pOut + oLen : pIn + ip : n);
      endif;
      ip += n;
      oLen += n;
      iter;
    endif;
    if typ = 3;
      xlSetErr('inflate: invalid block type');
      return *off;
    endif;
    useFix = (typ = 1);
    if not useFix;
      nlen = getBits(5) + 257;
      ndist = getBits(5) + 1;
      ncode = getBits(4) + 4;
      cl = 0;
      for i = 1 to ncode;
        cl(CLORD(i) + 1) = getBits(3);
      endfor;
      hufBuild(cl : 1 : 19 : tc);
      lens = 0;
      i = 0;
      dow i < nlen + ndist;
        sy = decode(tc);
        if bad or sy < 0;
          xlSetErr('inflate: bad code lengths');
          return *off;
        endif;
        if sy < 16;
          i += 1;
          lens(i) = sy;
        else;
          if sy = 16;
            if i = 0;
              xlSetErr('inflate: repeat without length');
              return *off;
            endif;
            v = lens(i);
            r = 3 + getBits(2);
          elseif sy = 17;
            v = 0;
            r = 3 + getBits(3);
          else;
            v = 0;
            r = 11 + getBits(7);
          endif;
          if i + r > nlen + ndist;
            xlSetErr('inflate: too many code lengths');
            return *off;
          endif;
          for k = 1 to r;
            i += 1;
            lens(i) = v;
          endfor;
        endif;
      enddo;
      hufBuild(lens : 1 : nlen : tl);
      hufBuild(lens : nlen + 1 : ndist : td);
    endif;
    // symbols of the block
    dow 1 = 1;
      if useFix;
        sy = decode(fixL);
      else;
        sy = decode(tl);
      endif;
      if bad or sy < 0;
        xlSetErr('inflate: bad data');
        return *off;
      endif;
      if sy < 256;
        if oLen >= oCap;
          xlSetErr('inflate: output larger than declared');
          return *off;
        endif;
        pd = pOut + oLen;
        bd = sy;
        oLen += 1;
      elseif sy = 256;
        leave;
      else;
        c = sy - 256;
        if c > 29;
          xlSetErr('inflate: bad length code');
          return *off;
        endif;
        l = LBASE(c) + getBits(LEXT(c));
        if useFix;
          c = decode(fixD) + 1;
        else;
          c = decode(td) + 1;
        endif;
        if c < 1 or c > 30;
          xlSetErr('inflate: bad distance code');
          return *off;
        endif;
        d = DBASE(c) + getBits(DEXT(c));
        if d > oLen or oLen + l > oCap;
          xlSetErr('inflate: bad distance');
          return *off;
        endif;
        if d >= l;
          memcpy(pOut + oLen : pOut + oLen - d : l);
          oLen += l;
        else;
          ps = pOut + oLen - d;
          pd = pOut + oLen;
          for k = 1 to l;
            bd = bs;
            ps += 1;
            pd += 1;
          endfor;
          oLen += l;
        endif;
      endif;
    enddo;
  enddo;
  if bad;
    xlSetErr('inflate: unexpected end of data');
    return *off;
  endif;
  return *on;
end-proc;
